    <sequenceFlow id="Flow_S02" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <sequenceFlow id="Flow_S03" name="Có" sourceRef="Gateway_Valid" targetRef="Task_Create" />
    <sequenceFlow id="Flow_S04" name="Không" sourceRef="Gateway_Valid" targetRef="Task_Invalid" />
    <sequenceFlow id="Flow_S05" sourceRef="Task_Invalid" targetRef="End_Invalid" />
    <receiveTask id="Task_ReceiveEvidence" name="Nhận chứng từ bổ sung">
      <incoming>Flow_S09</incoming>
      <outgoing>Flow_S10</outgoing>
    </receiveTask>
    <exclusiveGateway id="Gateway_Transfer" name="Chuyển hãng thành công?">
      <incoming>Flow_S16</incoming>
      <outgoing>Flow_S17</outgoing>
      <outgoing>Flow_S20</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_Merge" name="">
      <incoming>Flow_S14</incoming>
      <incoming>Flow_S15</incoming>
      <outgoing>Flow_S16</outgoing>
    </exclusiveGateway>
    <userTask id="Task_GHTK" name="CSKH liên hệ hỗ trợ GHTK">
