<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_VietGo_WF06" targetNamespace="https://vietgo.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <collaboration id="Collaboration_Complaint">
    <participant id="Participant_Shop" name="NGƯỜI GỬI HÀNG" />
    <participant id="Participant_VietGo" name="VIETGO" processRef="Process_VietGo_Complaint" />
    <participant id="Participant_GHN" name="GHN" />
    <participant id="Participant_GHTK" name="GHTK" />
    <messageFlow id="Message_M01" name="Gửi khiếu nại" sourceRef="Participant_Shop" targetRef="Start_Complaint" />
    <messageFlow id="Message_M02" name="Yêu cầu sửa" sourceRef="Task_Invalid" targetRef="Participant_Shop" />
    <messageFlow id="Message_M03" name="Yêu cầu bổ sung" sourceRef="Task_RequestEvidence" targetRef="Participant_Shop" />
    <messageFlow id="Message_M04" name="Gửi bổ sung" sourceRef="Participant_Shop" targetRef="Task_ReceiveEvidence" />
    <messageFlow id="Message_M05" name="Tạo ticket qua API" sourceRef="Task_GHN" targetRef="Participant_GHN" />
    <messageFlow id="Message_M06" name="Phản hồi GHN" sourceRef="Participant_GHN" targetRef="Task_Follow" />
    <messageFlow id="Message_M07" name="Chuyển tiếp thủ công" sourceRef="Task_GHTK" targetRef="Participant_GHTK" />
    <messageFlow id="Message_M08" name="Phản hồi GHTK" sourceRef="Participant_GHTK" targetRef="Task_Follow" />
    <messageFlow id="Message_M09" name="Kết quả" sourceRef="Task_Notify" targetRef="Participant_Shop" />
    <textAnnotation id="Note_ErrorHandling">
      <text>Chuyển hãng lỗi/chưa rõ: CSKH xác minh, không gửi lại GHN API khi chưa chắc chưa tạo ticket. GHTK luôn chuyển tiếp thủ công.</text>
    </textAnnotation>
  </collaboration>
  <process id="Process_VietGo_Complaint" name="WF-06 – Tiếp nhận và xử lý khiếu nại (P1)" isExecutable="false">
    <documentation>BPMN nghiệp vụ rút gọn. FR-25–28; AC-17–23; GHN Ticket API chỉ khi đủ quyền. GHN API timeout/403/không rõ kết quả: ticket VietGo được giữ lại, CSKH xác minh trạng thái trước retry; không đánh dấu đã chuyển thành công khi thiếu xác nhận. GHTK qua kênh hỗ trợ thủ công; không giả định có API ticket. Chứng từ phải qua kiểm tra quyền và dữ liệu; thao tác lặp cần chống trùng. WAITING_CUSTOMER/WAITING_CARRIER là trạng thái trong dữ liệu ticket; không đồng nhất trạng thái vận chuyển. Nhánh nhận kết quả có thể kéo dài nhiều ngày; Task_Follow là công việc chờ và ghi nhận phản hồi, không phải vòng lặp chạy liên tục. Với GHN timeout chưa xác nhận, CSKH không chuyển sang WAITING_CARRIER như thể GHN đã tiếp nhận; ghi trạng thái chuyển tiếp chưa rõ và xử lý ngoại lệ theo UC-06/SEQ-03.</documentation>
    <documentation>Workflow WF-06; Complaint P1. D01: FR-25..28, AC-17..23. Gateway chuyển hãng theo xác nhận hợp lệ; trạng thái chưa rõ xử lý thủ công. Gateway kết quả chờ cập nhật theo timer, không spin. GHN API ticket; GHTK liên hệ hỗ trợ thủ công; các hãng là participant ngoài dùng Message Flow.</documentation>
    <laneSet id="LaneSet_VietGo">
      <lane id="Lane_CSKH" name="CSKH VietGo">
        <flowNodeRef>Task_ReceiveEvidence</flowNodeRef>
        <flowNodeRef>Gateway_Transfer</flowNodeRef>
        <flowNodeRef>Gateway_Merge</flowNodeRef>
        <flowNodeRef>Task_GHTK</flowNodeRef>
        <flowNodeRef>Gateway_Carrier</flowNodeRef>
        <flowNodeRef>Gateway_Evidence</flowNodeRef>
        <flowNodeRef>Task_RequestEvidence</flowNodeRef>
        <flowNodeRef>Task_Review</flowNodeRef>
        <flowNodeRef>Activity_075pdzr</flowNodeRef>
        <flowNodeRef>Task_Notify</flowNodeRef>
        <flowNodeRef>End_Close</flowNodeRef>
        <flowNodeRef>Task_Result</flowNodeRef>
        <flowNodeRef>Gateway_Result</flowNodeRef>
        <flowNodeRef>Event_Wait</flowNodeRef>
        <flowNodeRef>Task_Follow</flowNodeRef>
        <flowNodeRef>Gateway_0gu66rn</flowNodeRef>
        <flowNodeRef>Activity_06r3hla</flowNodeRef>
        <flowNodeRef>Task_Escalate</flowNodeRef>
      </lane>
      <lane id="Lane_System" name="Hệ thống VietGo">
        <flowNodeRef>Start_Complaint</flowNodeRef>
        <flowNodeRef>Gateway_Valid</flowNodeRef>
        <flowNodeRef>Task_Validate</flowNodeRef>
        <flowNodeRef>Task_Invalid</flowNodeRef>
        <flowNodeRef>End_Invalid</flowNodeRef>
        <flowNodeRef>Task_GHN</flowNodeRef>
        <flowNodeRef>Task_Create</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Complaint" name="Nhận khiếu nại">
      <outgoing>Flow_S01</outgoing>
      <messageEventDefinition id="MessageDef_Start" />
    </startEvent>
    <exclusiveGateway id="Gateway_Valid" name="Hợp lệ?">
      <incoming>Flow_S02</incoming>
      <outgoing>Flow_S03</outgoing>
      <outgoing>Flow_S04</outgoing>
    </exclusiveGateway>
    <serviceTask id="Task_Validate" name="Kiểm tra quyền và dữ liệu">
      <incoming>Flow_S01</incoming>
      <outgoing>Flow_S02</outgoing>
    </serviceTask>
    <sendTask id="Task_Invalid" name="Thông báo yêu cầu sửa">
      <incoming>Flow_S04</incoming>
      <outgoing>Flow_S05</outgoing>
    </sendTask>
    <endEvent id="End_Invalid" name="Kết thúc yêu cầu lỗi">
      <incoming>Flow_S05</incoming>
    </endEvent>
    <sequenceFlow id="Flow_S06" sourceRef="Task_Create" targetRef="Task_Review" />
