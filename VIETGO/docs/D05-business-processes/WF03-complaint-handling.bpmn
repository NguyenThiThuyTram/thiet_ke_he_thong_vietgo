    <sequenceFlow id="Flow_S12" name="GHN" sourceRef="Gateway_Carrier" targetRef="Task_GHN" />
    <sequenceFlow id="Flow_S13" name="GHTK" sourceRef="Gateway_Carrier" targetRef="Task_GHTK" />
    <sequenceFlow id="Flow_S14" sourceRef="Task_GHN" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_S15" sourceRef="Task_GHTK" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_S16" sourceRef="Gateway_Merge" targetRef="Gateway_Transfer" />
    <sequenceFlow id="Flow_S17" name="Có" sourceRef="Gateway_Transfer" targetRef="Task_Follow" />
    <sequenceFlow id="Flow_S25" sourceRef="Event_Wait" targetRef="Task_Follow" />
    <sequenceFlow id="Flow_S22" sourceRef="Task_Follow" targetRef="Gateway_Result" />
    <sequenceFlow id="Flow_S23" name="Có" sourceRef="Gateway_Result" targetRef="Task_Result" />
    <sequenceFlow id="Flow_S18" sourceRef="Task_Result" targetRef="Task_Notify" />
    <sequenceFlow id="Flow_S19" sourceRef="Task_Notify" targetRef="End_Close" />
    <sequenceFlow id="Flow_S20" name="Không / chưa rõ" sourceRef="Gateway_Transfer" targetRef="Task_Escalate" />
    <sequenceFlow id="Flow_S24" name="Chưa" sourceRef="Gateway_Result" targetRef="Event_Wait" />
