      <incoming>Flow_S11</incoming>
      <outgoing>Flow_S12</outgoing>
      <outgoing>Flow_S13</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_Evidence" name="Cần bổ sung?">
      <incoming>Flow_S07</incoming>
      <outgoing>Flow_S08</outgoing>
      <outgoing>Flow_S11</outgoing>
    </exclusiveGateway>
    <sendTask id="Task_RequestEvidence" name="Yêu cầu bổ sung">
      <incoming>Flow_S08</incoming>
      <outgoing>Flow_S09</outgoing>
    </sendTask>
    <serviceTask id="Task_Create" name="Tạo ticket VietGo (OPEN)">
      <incoming>Flow_S03</incoming>
      <outgoing>Flow_S06</outgoing>
    </serviceTask>
    <userTask id="Task_Review" name="CSKH tiếp nhận và kiểm tra">
      <incoming>Flow_S06</incoming>
      <incoming>Flow_S10</incoming>
      <outgoing>Flow_S07</outgoing>
    </userTask>
    <sequenceFlow id="Flow_12m4fjn" name="Có" sourceRef="Gateway_0gu66rn" targetRef="Task_Follow" />
    <sequenceFlow id="Flow_1cup17j" name="Không" sourceRef="Gateway_0gu66rn" targetRef="Activity_075pdzr" />
    <sequenceFlow id="Flow_0bv7gle" sourceRef="Activity_075pdzr" targetRef="Task_Notify" />
    <userTask id="Activity_075pdzr" name="Cập nhật trạng thái chuyển tiếp thất bại">
      <incoming>Flow_1cup17j</incoming>
      <outgoing>Flow_0bv7gle</outgoing>
    </userTask>
    <sequenceFlow id="Flow_1xcod6y" sourceRef="Task_Escalate" targetRef="Activity_06r3hla" />
    <sequenceFlow id="Flow_12icq5g" sourceRef="Activity_06r3hla" targetRef="Gateway_0gu66rn" />
    <sendTask id="Task_Notify" name="Thông báo trạng thái/kết quả khiếu nại">
      <incoming>Flow_S18</incoming>
      <incoming>Flow_0bv7gle</incoming>
      <outgoing>Flow_S19</outgoing>
    </sendTask>
    <endEvent id="End_Close" name="Kết thúc xử lý">
      <incoming>Flow_S19</incoming>
    </endEvent>
    <userTask id="Task_Result" name="Cập nhật kết quả và lịch sử">
      <incoming>Flow_S23</incoming>
      <outgoing>Flow_S18</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_Result" name="Đã có kết quả?">
      <incoming>Flow_S22</incoming>
      <outgoing>Flow_S23</outgoing>
      <outgoing>Flow_S24</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="Event_Wait" name="Chờ cập nhật tiếp theo">
      <incoming>Flow_S24</incoming>
      <outgoing>Flow_S25</outgoing>
      <timerEventDefinition id="Timer_Wait_Result">
        <timeDuration xsi:type="tFormalExpression">PT24H</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <userTask id="Task_Follow" name="Theo dõi tiếp nhận và phản hồi từ hãng">
      <incoming>Flow_S17</incoming>
      <incoming>Flow_S25</incoming>
      <incoming>Flow_12m4fjn</incoming>
      <outgoing>Flow_S22</outgoing>
    </userTask>
    <exclusiveGateway id="Gateway_0gu66rn" name="Chuyển tiếp được sau xử lý?">
      <incoming>Flow_12icq5g</incoming>
      <outgoing>Flow_12m4fjn</outgoing>
      <outgoing>Flow_1cup17j</outgoing>
    </exclusiveGateway>
    <userTask id="Activity_06r3hla" name="Xử lý lỗi chuyển tiếp">
      <incoming>Flow_1xcod6y</incoming>
      <outgoing>Flow_12icq5g</outgoing>
    </userTask>
    <userTask id="Task_Escalate" name="CSKH xác minh chuyển tiếp">
      <documentation>GHN: khi timeout/chưa rõ kết quả, kiểm tra trước retry, không tự gửi lại mù. GHTK: ghi nhận lỗi liên hệ và kiểm tra kênh hỗ trợ phù hợp.</documentation>
      <incoming>Flow_S20</incoming>
      <outgoing>Flow_1xcod6y</outgoing>
    </userTask>
    <association id="Association_Err" sourceRef="Task_Escalate" targetRef="Note_ErrorHandling" />
  </process>
