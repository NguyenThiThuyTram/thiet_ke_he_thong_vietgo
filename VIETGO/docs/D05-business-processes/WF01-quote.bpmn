<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WF01-quote" targetNamespace="https://vietgo.edu.vn/d05" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:process id="Process_WF01-quote" name="WF01-quote" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF01-quote">
      <bpmn:lane id="Lane_System_WF01-quote" name="Hệ thống VietGo">
        <bpmn:flowNodeRef>Q_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_GHN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_GHNMap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_GHTKMap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_GHTK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Filter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Any</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_NoType</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_NoService</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_BothFail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Partial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Display</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_EndNone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_EndError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User_WF01-quote" name="Người gửi hàng">
        <bpmn:flowNodeRef>Q_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Q_EndOK</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Q_Start" name="Bắt đầu: yêu cầu báo giá">
      <bpmn:outgoing>Flow_WF01-quote_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Q_Form" name="Nhập địa chỉ, liên hệ, kiện hàng, khối lượng, COD (nếu có)">
      <bpmn:incoming>Flow_WF01-quote_1</bpmn:incoming>
      <bpmn:incoming>Flow_WF01-quote_6</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Q_Search" name="Chọn “Tra cứu cước”">
      <bpmn:incoming>Flow_WF01-quote_2</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Q_Fork" name="Gọi 2 hãng độc lập">
      <bpmn:incoming>Flow_WF01-quote_8</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF01-quote_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Q_GHN" name="Gửi báo giá GHN; timeout tối đa 10 giây">
      <bpmn:incoming>Flow_WF01-quote_9</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Q_GHNMap" name="Kiểm tra / chuẩn hóa GHN; ghi nhận lỗi">
      <bpmn:incoming>Flow_WF01-quote_11</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Q_GHTKMap" name="Kiểm tra / chuẩn hóa GHTK; ghi nhận lỗi">
      <bpmn:incoming>Flow_WF01-quote_12</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Q_Join" name="Đã nhận / xử lý cả hai nhánh">
      <bpmn:incoming>Flow_WF01-quote_13</bpmn:incoming>
      <bpmn:incoming>Flow_WF01-quote_14</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Q_Notice" name="Hiển thị cảnh báo hãng còn lại chưa khả dụng (A1)">
      <bpmn:incoming>Flow_WF01-quote_23</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_WF01-quote_1" sourceRef="Q_Start" targetRef="Q_Form" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_6" name="Nhập lại" sourceRef="Q_Invalid" targetRef="Q_Form" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_2" sourceRef="Q_Form" targetRef="Q_Search" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_3" sourceRef="Q_Search" targetRef="Q_Validate" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_4" sourceRef="Q_Validate" targetRef="Q_Valid" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_5" name="Không" sourceRef="Q_Valid" targetRef="Q_Invalid" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_7" name="Có" sourceRef="Q_Valid" targetRef="Q_Prepare" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_8" sourceRef="Q_Prepare" targetRef="Q_Fork" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_9" sourceRef="Q_Fork" targetRef="Q_GHN" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_10" sourceRef="Q_Fork" targetRef="Q_GHTK" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_11" sourceRef="Q_GHN" targetRef="Q_GHNMap" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_12" sourceRef="Q_GHTK" targetRef="Q_GHTKMap" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_13" sourceRef="Q_GHNMap" targetRef="Q_Join" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_14" sourceRef="Q_GHTKMap" targetRef="Q_Join" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_15" sourceRef="Q_Join" targetRef="Q_Filter" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_16" sourceRef="Q_Filter" targetRef="Q_Any" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_17" name="Không" sourceRef="Q_Any" targetRef="Q_NoType" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_22" name="Có" sourceRef="Q_Any" targetRef="Q_Partial" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_18" name="Không; API hợp lệ" sourceRef="Q_NoType" targetRef="Q_NoService" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_19" name="Có" sourceRef="Q_NoType" targetRef="Q_BothFail" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_20" sourceRef="Q_NoService" targetRef="Q_EndNone" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_21" sourceRef="Q_BothFail" targetRef="Q_EndError" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_23" name="Có" sourceRef="Q_Partial" targetRef="Q_Notice" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_24" name="Không" sourceRef="Q_Partial" targetRef="Q_Display" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_25" sourceRef="Q_Notice" targetRef="Q_Display" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_26" sourceRef="Q_Display" targetRef="Q_Select" />
    <bpmn:sequenceFlow id="Flow_WF01-quote_27" sourceRef="Q_Select" targetRef="Q_EndOK" />
    <bpmn:task id="Q_Validate" name="Kiểm tra bắt buộc / định dạng / tính hợp lệ">
      <bpmn:incoming>Flow_WF01-quote_3</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Q_Invalid" name="Nêu trường sai; yêu cầu chỉnh sửa (E1)">
      <bpmn:incoming>Flow_WF01-quote_5</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Q_Prepare" name="Chuẩn hóa địa chỉ, đơn vị theo từng API">
      <bpmn:incoming>Flow_WF01-quote_7</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Q_Valid" name="Thông tin hợp lệ?">
      <bpmn:incoming>Flow_WF01-quote_4</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF01-quote_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Q_GHTK" name="Gửi báo giá GHTK; timeout tối đa 10 giây">
      <bpmn:incoming>Flow_WF01-quote_10</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Q_Filter" name="Loại dịch vụ không hỗ trợ; phân biệt phí/ETA thiếu (A2-A4, E3)">
      <bpmn:incoming>Flow_WF01-quote_15</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Q_Any" name="Có Rate hợp lệ?">
      <bpmn:incoming>Flow_WF01-quote_16</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF01-quote_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Q_NoType" name="Lỗi kỹ thuật cả hai?">
      <bpmn:incoming>Flow_WF01-quote_17</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF01-quote_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Q_NoService" name="Không có dịch vụ phù hợp (A5); cho nhập lại">
      <bpmn:incoming>Flow_WF01-quote_18</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Q_BothFail" name="Ghi lỗi; báo không thể lấy giá; cho thử lại (E2/E3)">
      <bpmn:incoming>Flow_WF01-quote_19</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Q_Partial" name="Chỉ một hãng có Rate?">
      <bpmn:incoming>Flow_WF01-quote_22</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF01-quote_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Q_Display" name="Hiển thị bảng so sánh phí / ETA có căn cứ (VNĐ)">
      <bpmn:incoming>Flow_WF01-quote_24</bpmn:incoming>
      <bpmn:incoming>Flow_WF01-quote_25</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Q_EndNone" name="Kết thúc: không có Rate">
      <bpmn:incoming>Flow_WF01-quote_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Q_EndError" name="Kết thúc: lỗi báo giá">
      <bpmn:incoming>Flow_WF01-quote_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Q_Select" name="So sánh và chọn Rate hợp lệ">
      <bpmn:incoming>Flow_WF01-quote_26</bpmn:incoming>
      <bpmn:outgoing>Flow_WF01-quote_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Q_EndOK" name="Kết thúc: chuyển UC-02; chưa có vận đơn">
      <bpmn:incoming>Flow_WF01-quote_27</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
