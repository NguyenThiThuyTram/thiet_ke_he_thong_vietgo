    <bpmn:task id="S_Select" name="Chọn Rate hợp lệ">
      <bpmn:incoming>Flow_WF02-create-shipment_1</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Summary" name="Hiển thị người gửi/nhận, kiện, COD, hãng, phí">
      <bpmn:incoming>Flow_WF02-create-shipment_2</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Review" name="Người gửi kiểm tra thông tin">
      <bpmn:incoming>Flow_WF02-create-shipment_3</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_Edit" name="Cần sửa thông tin?">
      <bpmn:incoming>Flow_WF02-create-shipment_4</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Confirm" name="Nhấn “Xác nhận/Tạo vận đơn”">
      <bpmn:incoming>Flow_WF02-create-shipment_7</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_CheckSafe" name="Xác nhận chưa tạo và retry an toàn?">
      <bpmn:incoming>Flow_WF02-create-shipment_39</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_41</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_ReturnUC01" name="Chỉnh sửa; lấy báo giá lại nếu ảnh hưởng phí / dịch vụ (A1)">
      <bpmn:incoming>Flow_WF02-create-shipment_5</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndRerate" name="Kết thúc: trở lại UC-01">
      <bpmn:incoming>Flow_WF02-create-shipment_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_Start" name="Bắt đầu: Rate từ UC-01">
      <bpmn:outgoing>Flow_WF02-create-shipment_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="S_Check" name="Kiểm tra đăng nhập, quyền, dữ liệu, hiệu lực Rate">
      <bpmn:incoming>Flow_WF02-create-shipment_8</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_Valid" name="Đủ điều kiện?">
      <bpmn:incoming>Flow_WF02-create-shipment_9</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Invalid" name="Yêu cầu sửa / chọn Rate khác (A2)">
      <bpmn:incoming>Flow_WF02-create-shipment_10</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndInvalid" name="Kết thúc: chưa gửi booking">
      <bpmn:incoming>Flow_WF02-create-shipment_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Key" name="Tìm hoặc tạo booking_key duy nhất, bất biến">
      <bpmn:incoming>Flow_WF02-create-shipment_12</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_Dup" name="booking_key đã tồn tại?">
      <bpmn:incoming>Flow_WF02-create-shipment_13</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Status" name="Kiểm tra booking_status đã lưu">
      <bpmn:incoming>Flow_WF02-create-shipment_14</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Prepare" name="Lưu PENDING và booking_attempts (cùng booking_key)">
      <bpmn:incoming>Flow_WF02-create-shipment_22</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Call" name="Backend gửi booking đến đúng hãng đã chọn (≤10 giây)">
      <bpmn:incoming>Flow_WF02-create-shipment_23</bpmn:incoming>
      <bpmn:incoming>Flow_WF02-create-shipment_43</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_DupState" name="booking_status?">
      <bpmn:incoming>Flow_WF02-create-shipment_15</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_DupOK" name="SUCCESS: trả lại vận đơn đã lưu">
      <bpmn:incoming>Flow_WF02-create-shipment_16</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_DupHold" name="PENDING/UNKNOWN: báo đang xử lý/xác minh">
      <bpmn:incoming>Flow_WF02-create-shipment_17</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_DupFail" name="FAILED: hiển thị kết quả từ chối; không tự gửi lại">
      <bpmn:incoming>Flow_WF02-create-shipment_18</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndDupOK" name="Kết thúc: kết quả đã có">
      <bpmn:incoming>Flow_WF02-create-shipment_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndDupFail" name="Kết thúc: FAILED đã lưu">
      <bpmn:incoming>Flow_WF02-create-shipment_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndDupHold" name="Kết thúc: không tạo đơn trùng">
      <bpmn:incoming>Flow_WF02-create-shipment_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="S_Result" name="Kết quả từ carrier?">
      <bpmn:incoming>Flow_WF02-create-shipment_24</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Save" name="Có xác nhận tạo: lưu Shipment, mã VietGo / hãng, phí, COD">
      <bpmn:incoming>Flow_WF02-create-shipment_25</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Unknown" name="Timeout / phản hồi chưa rõ: đặt UNKNOWN; giữ key và attempts (E2/E3)">
      <bpmn:incoming>Flow_WF02-create-shipment_33</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Reject" name="Carrier từ chối: đặt FAILED; thông báo lý do (E1)">
      <bpmn:incoming>Flow_WF02-create-shipment_31</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_SaveOK" name="Lưu an toàn thành công?">
      <bpmn:incoming>Flow_WF02-create-shipment_26</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="S_EndRejected" name="Kết thúc: carrier từ chối">
      <bpmn:incoming>Flow_WF02-create-shipment_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Complete" name="Đặt SUCCESS; hiển thị mã / chi tiết đã xác nhận (A3)">
      <bpmn:incoming>Flow_WF02-create-shipment_27</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_SaveFail" name="Lỗi lưu / thiếu căn cứ: lưu dấu vết; không báo hoàn tất (E3)">
      <bpmn:incoming>Flow_WF02-create-shipment_29</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndSaveFail" name="Kết thúc: cần khôi phục an toàn">
      <bpmn:incoming>Flow_WF02-create-shipment_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndSuccess" name="Kết thúc: tạo đơn thành công">
      <bpmn:incoming>Flow_WF02-create-shipment_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Notify" name="Thông báo “Đang xác minh kết quả tạo vận đơn”">
      <bpmn:incoming>Flow_WF02-create-shipment_34</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Reconcile" name="Truy vấn / đối chiếu kết quả carrier bằng mã tham chiếu nếu hỗ trợ">
      <bpmn:incoming>Flow_WF02-create-shipment_35</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_VResult" name="Kết quả xác minh?">
      <bpmn:incoming>Flow_WF02-create-shipment_36</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_37</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Confirmed" name="Carrier xác nhận đã tạo: lưu Shipment; SUCCESS; không retry">
      <bpmn:incoming>Flow_WF02-create-shipment_37</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndConfirmed" name="Kết thúc: đã xác minh tạo thành công">
      <bpmn:incoming>Flow_WF02-create-shipment_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Manual" name="Không thể xác minh / retry không an toàn: giữ UNKNOWN, xử lý thủ công">
      <bpmn:incoming>Flow_WF02-create-shipment_40</bpmn:incoming>
      <bpmn:incoming>Flow_WF02-create-shipment_42</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_44</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Retry" name="Retry có kiểm soát, sử dụng lại booking_key">
      <bpmn:incoming>Flow_WF02-create-shipment_41</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndManual" name="Kết thúc: UNKNOWN">
      <bpmn:incoming>Flow_WF02-create-shipment_44</bpmn:incoming>
    </bpmn:endEvent>
