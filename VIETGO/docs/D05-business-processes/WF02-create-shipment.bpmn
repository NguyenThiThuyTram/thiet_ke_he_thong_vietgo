        <bpmn:flowNodeRef>S_Call</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User_WF02-create-shipment" name="Người gửi hàng">
        <bpmn:flowNodeRef>S_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="S_Select" name="Chọn Rate hợp lệ">
      <bpmn:incoming>Flow_WF02-create-shipment_1</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Summary" name="Hiển thị thông tin vận đơn">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Hiển thị người gửi/nhận, kiện, COD, hãng, phí</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_2</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Review" name="Kiểm tra thông tin vận đơn">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Người gửi kiểm tra thông tin</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_3</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_Edit" name="Cần sửa&#10;thông tin?">
      <bpmn:incoming>Flow_WF02-create-shipment_4</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="S_Start" name="Nhận Rate từ UC-01">
      <bpmn:outgoing>Flow_WF02-create-shipment_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="S_Valid" name="Đủ điều kiện?">
      <bpmn:incoming>Flow_WF02-create-shipment_9</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Invalid" name="Yêu cầu sửa hoặc chọn Rate khác">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Yêu cầu sửa / chọn Rate khác (A2)</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_10</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndInvalid" name="Chưa đủ điều kiện tạo đơn">
      <bpmn:incoming>Flow_WF02-create-shipment_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Key" name="Xác lập booking_key">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Tìm hoặc tạo booking_key duy nhất, bất biến</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_12</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_Dup" name="booking_key đã tồn tại?">
      <bpmn:incoming>Flow_WF02-create-shipment_13</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_1" sourceRef="S_Start" targetRef="S_Select" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_2" sourceRef="S_Select" targetRef="S_Summary" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_3" sourceRef="S_Summary" targetRef="S_Review" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_4" sourceRef="S_Review" targetRef="S_Edit" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_5" name="Có" sourceRef="S_Edit" targetRef="S_ReturnUC01" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_7" name="Không" sourceRef="S_Edit" targetRef="S_Confirm" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_8" sourceRef="S_Confirm" targetRef="S_Check" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_41" name="Có; hãng bảo đảm" sourceRef="S_CheckSafe" targetRef="S_Retry" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_6" sourceRef="S_ReturnUC01" targetRef="S_EndRerate" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_9" sourceRef="S_Check" targetRef="S_Valid" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_10" name="Không" sourceRef="S_Valid" targetRef="S_Invalid" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_12" name="Có" sourceRef="S_Valid" targetRef="S_Key" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_11" sourceRef="S_Invalid" targetRef="S_EndInvalid" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_13" sourceRef="S_Key" targetRef="S_Dup" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_14" name="Có" sourceRef="S_Dup" targetRef="S_Status" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_22" name="Không" sourceRef="S_Dup" targetRef="S_Prepare" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_15" sourceRef="S_Status" targetRef="S_DupState" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_23" sourceRef="S_Prepare" targetRef="S_Call" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_43" name="Cùng booking_key" sourceRef="S_Retry" targetRef="S_Call" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_24" sourceRef="S_Call" targetRef="S_Result" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_16" name="SUCCESS" sourceRef="S_DupState" targetRef="S_DupOK" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_17" name="PENDING/UNKNOWN" sourceRef="S_DupState" targetRef="S_DupHold" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_18" name="FAILED" sourceRef="S_DupState" targetRef="S_DupFail" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_25" name="Thành công" sourceRef="S_Result" targetRef="S_Save" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_31" name="Từ chối" sourceRef="S_Result" targetRef="S_Reject" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_33" name="Timeout / chưa rõ" sourceRef="S_Result" targetRef="S_Unknown" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_26" sourceRef="S_Save" targetRef="S_SaveOK" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_34" sourceRef="S_Unknown" targetRef="S_Notify" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_32" sourceRef="S_Reject" targetRef="S_EndRejected" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_37" name="Đã tạo" sourceRef="S_VResult" targetRef="S_Confirmed" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_38" sourceRef="S_Confirmed" targetRef="S_EndConfirmed" />
    <bpmn:task id="S_ReturnUC01" name="Chỉnh sửa và báo giá lại">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Chỉnh sửa; lấy báo giá lại nếu ảnh hưởng phí / dịch vụ (A1)</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_5</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Confirm" name="Xác nhận tạo vận đơn">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Nhấn “Xác nhận/Tạo vận đơn”</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_7</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndRerate" name="Quay lại UC-01 để báo giá">
      <bpmn:incoming>Flow_WF02-create-shipment_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Check" name="Kiểm tra điều kiện tạo đơn">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Kiểm tra đăng nhập, quyền, dữ liệu, hiệu lực Rate</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_8</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Status" name="Kiểm tra trạng thái booking">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Kiểm tra booking_status đã lưu</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_14</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_DupState" name="booking_status?">
      <bpmn:incoming>Flow_WF02-create-shipment_15</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_DupOK" name="Trả lại vận đơn đã lưu">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): SUCCESS: trả lại vận đơn đã lưu</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_16</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_DupHold" name="Thông báo yêu cầu đang xử lý">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): PENDING/UNKNOWN: báo đang xử lý/xác minh</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_17</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_DupFail" name="Thông báo yêu cầu đã thất bại">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): FAILED: hiển thị kết quả từ chối; không tự gửi lại</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_18</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndDupOK" name="Vận đơn đã tồn tại">
      <bpmn:incoming>Flow_WF02-create-shipment_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndDupFail" name="Yêu cầu trước đã thất bại">
      <bpmn:incoming>Flow_WF02-create-shipment_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndDupHold" name="Yêu cầu đang được xử lý">
      <bpmn:incoming>Flow_WF02-create-shipment_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_19" sourceRef="S_DupOK" targetRef="S_EndDupOK" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_20" sourceRef="S_DupHold" targetRef="S_EndDupHold" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_21" sourceRef="S_DupFail" targetRef="S_EndDupFail" />
    <bpmn:exclusiveGateway id="S_Result" name="Kết quả từ carrier?">
      <bpmn:incoming>Flow_WF02-create-shipment_24</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Reject" name="Ghi nhận hãng từ chối">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Carrier từ chối: đặt FAILED; thông báo lý do (E1)</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_31</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Save" name="Lưu thông tin vận đơn">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Có xác nhận tạo: lưu Shipment, mã VietGo / hãng, phí, COD</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_25</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Unknown" name="Ghi nhận trạng thái UNKNOWN">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Timeout / phản hồi chưa rõ: đặt UNKNOWN; giữ key và attempts (E2/E3)</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_33</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_SaveOK" name="Lưu an toàn thành công?">
      <bpmn:incoming>Flow_WF02-create-shipment_26</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="S_Complete" name="Hoàn tất tạo vận đơn">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Đặt SUCCESS; hiển thị mã / chi tiết đã xác nhận (A3)</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_27</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_SaveFail" name="Ghi nhận lỗi lưu vận đơn">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Lỗi lưu / thiếu căn cứ: lưu dấu vết; không báo hoàn tất (E3)</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_29</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndSaveFail" name="Cần khôi phục dữ liệu">
      <bpmn:incoming>Flow_WF02-create-shipment_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="S_EndSuccess" name="Vận đơn được tạo thành công">
      <bpmn:incoming>Flow_WF02-create-shipment_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_27" name="Có" sourceRef="S_SaveOK" targetRef="S_Complete" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_29" name="Không" sourceRef="S_SaveOK" targetRef="S_SaveFail" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_28" sourceRef="S_Complete" targetRef="S_EndSuccess" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_30" sourceRef="S_SaveFail" targetRef="S_EndSaveFail" />
    <bpmn:endEvent id="S_EndRejected" name="Hãng vận chuyển từ chối">
      <bpmn:incoming>Flow_WF02-create-shipment_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Notify" name="Thông báo đang xác minh">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Thông báo “Đang xác minh kết quả tạo vận đơn”</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_34</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="S_Reconcile" name="Đối chiếu kết quả với hãng">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Truy vấn / đối chiếu kết quả carrier bằng mã tham chiếu nếu hỗ trợ</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_35</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="S_VResult" name="Kết quả xác minh?">
      <bpmn:incoming>Flow_WF02-create-shipment_36</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_37</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_WF02-create-shipment_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_39" name="Chưa tạo" sourceRef="S_VResult" targetRef="S_CheckSafe" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_42" name="Không" sourceRef="S_CheckSafe" targetRef="S_Manual" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_35" sourceRef="S_Notify" targetRef="S_Reconcile" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_36" sourceRef="S_Reconcile" targetRef="S_VResult" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_40" name="Không xác minh được" sourceRef="S_VResult" targetRef="S_Manual" />
    <bpmn:sequenceFlow id="Flow_WF02-create-shipment_44" sourceRef="S_Manual" targetRef="S_EndManual" />
    <bpmn:task id="S_Confirmed" name="Lưu vận đơn đã xác minh">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Carrier xác nhận đã tạo: lưu Shipment; SUCCESS; không retry</bpmn:documentation>
      <bpmn:incoming>Flow_WF02-create-shipment_37</bpmn:incoming>
      <bpmn:outgoing>Flow_WF02-create-shipment_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="S_EndConfirmed" name="Đã xác minh tạo vận đơn">
      <bpmn:incoming>Flow_WF02-create-shipment_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="S_Manual" name="Chuyển xử lý thủ công">
      <bpmn:documentation>Chi tiết nghiệp vụ (tên gốc): Không thể xác minh / retry không an toàn: giữ UNKNOWN, xử lý thủ công</bpmn:documentation>
