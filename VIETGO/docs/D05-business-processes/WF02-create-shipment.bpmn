  <bpmn:process id="Process_WF02-create-shipment" name="WF02-create-shipment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_WF02-create-shipment">
      <bpmn:lane id="Lane_System_WF02-create-shipment" name="Hệ thống VietGo">
