
@startuml
hide circle
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle

' ==========================================
' 01. DOMAIN P0
' ==========================================

package "DOMAIN P0 - THUC THE NGHIEP VU" {

  class User {
    - userId: Long
    - email: String
    - role: UserRole
    --
    + canAccess(shipmentId): Boolean
  }

  class RateRequest {
    - rateRequestId: UUID
    - userId: Long
    - codAmount: Decimal
    --
    + validate(): Boolean
  }

  class Parcel {
    - parcelId: UUID
    - rateRequestId: UUID
    - weightGrams: Integer
    - declaredValue: Decimal
    --
    + validateDimensions(): Boolean
  }

  class ParcelItem {
    - parcelItemId: UUID
    - parcelId: UUID
    - itemName: String
    - quantity: Integer
    - itemPrice: Decimal
    --
    + subtotal(): Decimal
  }

  class QuoteAttempt {
    - quoteAttemptId: UUID
    - rateRequestId: UUID
    - carrierId: UUID
    - requestStatus: String
    - isMock: Boolean
    --
    + recordResult(): void
  }

  class Rate {
    - rateId: Long
    - quoteAttemptId: UUID
    - serviceId: UUID
    - totalFee: Decimal?
    - etaMinDays: Integer?
    - expiresAt: DateTime?
    --
    + isSelectable(): Boolean
  }

  class Carrier {
    - carrierId: UUID
    - carrierCode: String
    - carrierName: String
    - isActive: Boolean
    --
    + isAvailable(): Boolean
  }

  class CarrierService {
    - serviceId: UUID
    - carrierId: UUID
    - serviceCode: String
    - serviceName: String
    - isActive: Boolean
    --
    + supportsRoute(): Boolean
  }

  class Shipment {
    - shipmentId: Long
    - userId: Long
    - rateId: Long
    - shipmentStatus: String?
    - bookingKey: String {unique}
    - bookingStatus: BookingStatus
    - codAmount: Decimal
    --
    + markBookingUnknown(): void
    + confirmBooking(code): void
  }

  class BookingAttempt {
    - bookingAttemptId: UUID
    - shipmentId: Long
    - attemptNo: Integer
    - attemptStatus: BookingStatus
    - carrierReference: String?
    --
    + recordResponse(): void
  }

  class TrackingEvent {
    - trackingEventId: UUID
    - shipmentId: Long
    - shipmentStatus: String?
    - carrierStatus: String
    - normalizedStatus: String?
    - eventTime: DateTime
    --
    + normalize(): String?
  }

  class ShipmentStatus {
    - statusCode: String
    - statusName: String
    - isFinal: Boolean
    --
    + isTerminal(): Boolean
  }
}

' ==========================================
' 02. APPLICATION SERVICES P0
' ==========================================

package "APPLICATION SERVICES P0" {

  class QuoteService <<service>> {
    + getQuotes(input): List<Rate>
    + normalizeQuotes(): List<Rate>
  }

  class ShipmentService <<service>> {
    + createShipment(rateId, key): Shipment
    + checkCarrierBeforeRetry(): BookingStatus
  }

  class TrackingService <<service>> {
    + getCurrentStatus(id): String
    + getHistory(id): List<TrackingEvent>
  }
}

' ==========================================
' 03. CARRIER INTEGRATION P0
' ==========================================

package "CARRIER INTEGRATION P0" {

  interface CarrierAdapter {
    + getRates(request): List<Rate>
    + createBooking(s): BookingResult
    + findBooking(reference): BookingResult?
    + getTracking(code): List<TrackingEvent>
  }

  class GHNAdapter <<adapter>> {
    + getRates(): List<Rate>
    + createBooking(): BookingResult
  }

  class GHTKAdapter <<adapter>> {
    + getRates(): List<Rate>
    + createBooking(): BookingResult
  }

  class BookingResult <<DTO>> {
    - status: BookingStatus
    - carrierTrackingCode: String?
    - carrierReference: String?
    --
    + isConfirmed(): Boolean
  }
}

' ==========================================
' 04. REPEATBOX P1
' ==========================================

package "REPEATBOX P1" {

  class ShipmentTemplate {
    - templateId: UUID
    - userId: Long
    - templateName: String
    --
    + updateSnapshot(): void
  }

  class RepeatPlan {
    - repeatPlanId: UUID
    - templateId: UUID
    - userId: Long
    - frequency: RepeatFrequency
    - planStatus: RepeatPlanStatus
    - nextRunDate: Date
    --
    + pause(): void
    + resume(): void
  }

  class RepeatOccurrence {
    - occurrenceId: UUID
    - repeatPlanId: UUID
    - rateRequestId: UUID?
    - shipmentId: Long?
    - scheduledFor: Date
    - status: RepeatOccurrenceStatus
    --
    + markSkipped(): void
    + linkShipment(s): void
  }

  class RepeatBoxService <<service>> {
    + createDraftForDuePlan(): RepeatOccurrence
    + skipOccurrence(id): void
  }
}

' ==========================================
' 05. VALUE TYPES / ENUMS
' ==========================================

package "VALUE TYPES - ENUM" {

  enum UserRole {
    USER
    ADMIN
  }

  enum BookingStatus {
    PENDING
    SUCCESS
    FAILED
    UNKNOWN
  }

  enum RepeatFrequency {
    WEEKLY
    MONTHLY
  }

  enum RepeatPlanStatus {
    ACTIVE
    PAUSED
    ENDED
  }

  enum RepeatOccurrenceStatus {
    DRAFT_READY
    SKIPPED
    SHIPMENT_CREATED
  }
}

' ==========================================
' 06. COMPLAINT MODULE - UC-06
' ==========================================

package "06 COMPLAINT MODULE - UC-06" {

  class Complaint {
    - complaintId: Long
    - shipmentId: Long
    - userId: Long
    - carrierTicketId: String?
    - reason: String
    - description: String
    - status: String
    - createdAt: DateTime
    --
    + submit(): void
    + updateStatus(status: String): void
    + close(): void
  }

  class ComplaintEvidence {
    - evidenceId: Long
    - complaintId: Long
    - fileUrl: String
    - fileType: String
    - uploadedAt: DateTime
    --
    + validateFile(): Boolean
  }

  class ComplaintHistory {
    - historyId: Long
    - complaintId: Long
    - action: String
    - oldStatus: String?
    - newStatus: String
    - createdAt: DateTime
    --
    + recordChange(): void
  }

  class ComplaintService <<service>> {
    + createComplaint(): Complaint
    + addEvidence(): void
    + updateComplaintStatus(): void
    + getComplaintHistory(): List<ComplaintHistory>
  }

  class ComplaintRepository <<repository>> {
    + save(complaint: Complaint): void
    + findById(id: Long): Complaint?
    + findByShipment(id: Long): List<Complaint>
    + saveHistory(history: ComplaintHistory): void
  }

  class CarrierSupportGateway <<gateway>> {
    + submitGHNTicket(complaint: Complaint): String?
    + getGHNTicketDetail(id: String): String
    + recordManualForward(complaint: Complaint): void
    + syncSupportResult(id: Long): void
  }
}

' ==========================================
' UML RELATIONSHIPS - DOMAIN P0
' ==========================================

User "1" -- "0..*" RateRequest : creates

RateRequest "1" *-- "0..1" Parcel : has
Parcel "1" *-- "0..*" ParcelItem : contains

RateRequest "1" *-- "0..*" QuoteAttempt : logs
QuoteAttempt "0..*" --> "1" Carrier : for
QuoteAttempt "1" *-- "0..*" Rate : returns

Carrier "1" -- "0..*" CarrierService : provides
CarrierService "1" -- "0..*" Rate : offered in

User "1" -- "0..*" Shipment : owns
Rate "1" -- "0..1" Shipment : selected for

Shipment "1" *-- "0..*" BookingAttempt : records
Shipment "1" *-- "0..*" TrackingEvent : has history

Shipment "0..*" --> "0..1" ShipmentStatus : current status
TrackingEvent "0..*" --> "0..1" ShipmentStatus : mapped to

' ==========================================
' UML RELATIONSHIPS - REPEATBOX P1
' ==========================================

User "1" -- "0..*" ShipmentTemplate : owns

ShipmentTemplate "1" -- "0..*" RepeatPlan : used by

RepeatPlan "1" *-- "0..*" RepeatOccurrence : schedules

RepeatOccurrence "0..1" --> "0..1" Shipment : links after success
RepeatOccurrence "0..1" --> "0..1" RateRequest : re-quotes via

' ==========================================
' DEPENDENCIES / REALIZATION
' ==========================================

QuoteService ..> CarrierAdapter : uses
ShipmentService ..> CarrierAdapter : uses
TrackingService ..> CarrierAdapter : uses

RepeatBoxService ..> RepeatPlan : manages
RepeatBoxService ..> RepeatOccurrence : creates

GHNAdapter ..|> CarrierAdapter
GHTKAdapter ..|> CarrierAdapter

CarrierAdapter ..> BookingResult : returns

' ==========================================
' UML RELATIONSHIPS - COMPLAINT UC-06
' ==========================================

' Association
User "1" -- "0..*" Complaint : submits
Shipment "1" -- "0..*" Complaint : has complaints

' Composition
Complaint "1" *-- "0..*" ComplaintEvidence : has evidence
Complaint "1" *-- "0..*" ComplaintHistory : records history

' Dependency
ComplaintService ..> Complaint : manages
ComplaintService ..> ComplaintRepository : uses
ComplaintService ..> CarrierSupportGateway : forwards via
ComplaintRepository ..> Complaint : persists

note right of CarrierSupportGateway
  GHN: Official Complaint Ticket API
  GHTK: Manual forwarding via CSKH
  No unverified GHTK complaint API
end note

@enduml
